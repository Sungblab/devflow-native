{
  "schemaVersion": 1,
  "projectName": "devflow-demo",
  "defaultProfile": "standard",
  "defaultPlatform": "windows-powershell",
  "docsRouter": "docs/README.md",
  "skillsPath": "skills",
  "agentAdapters": ["codex", "claude-code", "gemini-cli", "generic-shell"],
  "platformAdapters": ["windows-powershell", "wsl-linux", "linux", "macos"],
  "gates": {
    "docs": {
      "description": "Read docs router and ensure key links exist",
      "command": "devflow doctor docs"
    },
    "status": {
      "description": "Inspect git, work items, gates, and latest handoffs",
      "command": "devflow status"
    }
  },
  "split": {
    "tasks": [
      {
        "id": "implementation",
        "role": "implementation",
        "ownedPaths": ["packages/**"],
        "avoidPaths": ["docs/**"],
        "verification": [{ "cwd": ".", "command": "npm test" }]
      },
      {
        "id": "docs-audit",
        "role": "audit",
        "ownedPaths": ["docs/**"],
        "avoidPaths": ["packages/**"],
        "verification": [{ "cwd": ".", "command": "npm run docs:check" }]
      }
    ]
  }
}
