{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solo-devflow-os.local/experiments/result.schema.json",
  "title": "Devflow Experiment Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "taskId",
    "condition",
    "continuationSuccess",
    "falseCompletion",
    "tokenCost",
    "timeToFirstUsefulEdit",
    "irrelevantFileReadCount",
    "repeatedExplorationCount",
    "handoffCompleteness",
    "handoffFaithfulness",
    "handoffMinimality",
    "handoffActionability"
  ],
  "properties": {
    "taskId": {
      "type": "string"
    },
    "condition": {
      "type": "string"
    },
    "continuationSuccess": {
      "type": "boolean"
    },
    "falseCompletion": {
      "type": "boolean"
    },
    "tokenCost": {
      "type": "integer",
      "minimum": 0
    },
    "timeToFirstUsefulEdit": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "irrelevantFileReadCount": {
      "type": "integer",
      "minimum": 0
    },
    "repeatedExplorationCount": {
      "type": "integer",
      "minimum": 0
    },
    "handoffCompleteness": {
      "type": "number",
      "minimum": 0,
      "maximum": 2
    },
    "handoffFaithfulness": {
      "type": "number",
      "minimum": 0,
      "maximum": 2
    },
    "handoffMinimality": {
      "type": "number",
      "minimum": 0,
      "maximum": 2
    },
    "handoffActionability": {
      "type": "number",
      "minimum": 0,
      "maximum": 2
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
