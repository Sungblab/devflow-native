{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solo-devflow-os.local/experiments/hidden-eval.schema.json",
  "title": "Devflow Hidden Evaluation Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "taskId",
    "goldNextAction",
    "expectedFinalFixSummary",
    "goldChangedFiles",
    "goldContextPointers",
    "hiddenAcceptanceNotes",
    "expectedFalseCompletionRisks"
  ],
  "properties": {
    "version": {
      "const": "devflow.hiddenEval.v1"
    },
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "goldNextAction": {
      "type": "string",
      "minLength": 1
    },
    "expectedFinalFixSummary": {
      "type": "string",
      "minLength": 1
    },
    "goldChangedFiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "label"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "goldContextPointers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "label"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "hiddenAcceptanceNotes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expectedFalseCompletionRisks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
