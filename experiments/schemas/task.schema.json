{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solo-devflow-os.local/experiments/task.schema.json",
  "title": "Devflow Experiment Task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "taskId",
    "repoFixture",
    "initialPrompt",
    "interruptionSnapshot",
    "acceptanceCriteria",
    "requiredGates",
    "goldChangedFiles",
    "goldContextPointers",
    "expectedRisks"
  ],
  "properties": {
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "repoFixture": {
      "type": "string",
      "minLength": 1
    },
    "initialPrompt": {
      "type": "string",
      "minLength": 1
    },
    "interruptionSnapshot": {
      "type": "string",
      "minLength": 1
    },
    "acceptanceCriteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requiredGates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "command"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "goldChangedFiles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "goldContextPointers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "reason"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "expectedRisks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
