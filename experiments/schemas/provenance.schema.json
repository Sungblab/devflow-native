{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solo-devflow-os.local/experiments/provenance.schema.json",
  "title": "Devflow Experiment Provenance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "taskId",
    "claims"
  ],
  "properties": {
    "version": {
      "const": "devflow.provenance.v1"
    },
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "conditionId",
          "claimId",
          "claimText",
          "sourceArtifactType",
          "sourceReference",
          "observable"
        ],
        "properties": {
          "conditionId": {
            "type": "string",
            "minLength": 1
          },
          "claimId": {
            "type": "string",
            "minLength": 1
          },
          "claimText": {
            "type": "string",
            "minLength": 1
          },
          "sourceArtifactType": {
            "type": "string",
            "enum": [
              "original prompt",
              "raw transcript",
              "file read",
              "edit",
              "git diff",
              "command log",
              "gate output",
              "user statement"
            ]
          },
          "sourceReference": {
            "type": "string",
            "minLength": 1
          },
          "observable": {
            "const": true
          }
        }
      }
    }
  }
}
