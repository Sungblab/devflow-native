{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solo-devflow-os.local/experiments/run.schema.json",
  "title": "Devflow Experiment Run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "taskId",
    "condition",
    "agent",
    "model",
    "startedAt",
    "finishedAt",
    "tokenUsage",
    "toolCalls",
    "filesRead",
    "filesChanged",
    "finalStatus",
    "completionClaim",
    "gateEvidenceRefs",
    "handoff"
  ],
  "properties": {
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "condition": {
      "type": "string",
      "enum": [
        "no-handoff",
        "raw-transcript",
        "token-matched-summary",
        "structured-handoff",
        "gate-only",
        "structured-handoff-plus-gate",
        "human-oracle"
      ]
    },
    "agent": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "finishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "tokenUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "output", "total"],
      "properties": {
        "input": {
          "type": "integer",
          "minimum": 0
        },
        "output": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "toolCalls": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "filesRead": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "filesChanged": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "finalStatus": {
      "type": "string",
      "enum": ["completed", "blocked", "failed", "abandoned", "unknown"]
    },
    "completionClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claimedDone", "text"],
      "properties": {
        "claimedDone": {
          "type": "boolean"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "gateEvidenceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "handoff": {
      "type": ["object", "null"]
    }
  }
}
